# Terraform working directory & provider binaries
**/.terraform/*

# State files (contain resource IDs and the generated DB password in plain text)
*.tfstate
*.tfstate.*
*.state

# Crash logs
crash.log
crash.*.log

# Variable files with environment-specific values (commit *.example instead)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Generated SSH private keys
*.pem

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output
*.tfplan
tfplan

# OS / editor noise
.DS_Store
.vscode/
.idea/
